NOTSIP_HOST=127.0.0.1
NOTSIP_PORT=8765
NOTSIP_DATA_DIR=./data
NOTSIP_LOCAL_TIMEZONE=Africa/Kigali
NOTSIP_MAX_TOOL_ROUNDS=10
NOTSIP_AUTONOMY_LEVEL=2
NOTSIP_SELF_MODIFY_ENABLED=false
# JSON object: capability -> minimum autonomy level (0-4). Unknown capabilities default to 4.
NOTSIP_CAPABILITY_LEVELS={"COMPUTE":0,"INTELLIGENCE":0,"INTERNET_SEARCH":0,"READ_FILES":0,"READ_CALENDAR":1,"READ_EMAIL":1,"MEDIA":1,"PERCEPTION":1,"SYSTEM_DIAGNOSTICS":0,"WRITE_FILES":2,"CONTROL_COMPUTER":3,"ANDROID_CONTROL":3,"SEND_EMAIL":3,"SELF_MAINTENANCE":4,"CONTROL_HOME":3,"CONTROL_SERVER":4,"EXECUTE_CODE":4,"CODE_EXECUTION":4,"SIMULATION":4,"CONTROL_ROBOTICS":4,"ACCESS_CAMERA":2,"ACCESS_MICROPHONE":2}
NOTSIP_API_KEY=
NOTSIP_EVENT_HMAC_SECRET=
NOTSIP_PAIRING_SECRET=
NOTSIP_AUTH_MODE=api_key
NOTSIP_SESSION_TTL=43200
NOTSIP_OIDC_PROVIDER=generic
NOTSIP_OIDC_ISSUER=
NOTSIP_OIDC_CLIENT_ID=
NOTSIP_OIDC_CLIENT_SECRET=
NOTSIP_OIDC_REDIRECT_URI=http://127.0.0.1:8765/api/oauth/callback
NOTSIP_OIDC_SCOPES=openid profile email
NOTSIP_LLM_BASE_URL=
NOTSIP_LLM_API_KEY=
NOTSIP_LLM_MODEL=
NOTSIP_FALLBACK_LLM_BASE_URL=
NOTSIP_FALLBACK_LLM_API_KEY=
NOTSIP_FALLBACK_LLM_MODEL=
NOTSIP_STT_BASE_URL=
NOTSIP_STT_API_KEY=
NOTSIP_STT_MODEL=
NOTSIP_STT_LANGUAGE=
NOTSIP_TTS_BASE_URL=
NOTSIP_TTS_API_KEY=
NOTSIP_TTS_MODEL=
NOTSIP_TTS_VOICE=alloy
NOTSIP_TTS_FORMAT=mp3
NOTSIP_VOICE_ENABLED=false
NOTSIP_NATIVE_VOICE_ENABLED=false
NOTSIP_VISION_ENABLED=true
NOTSIP_PERCEPTION_ENABLED=true
NOTSIP_PERCEPTION_INTERVAL=10
NOTSIP_BRAVE_API_KEY=
NOTSIP_BROWSER_ENABLED=true
NOTSIP_SMTP_HOST=
NOTSIP_SMTP_PORT=587
NOTSIP_IMAP_HOST=
NOTSIP_EMAIL_USERNAME=
NOTSIP_EMAIL_PASSWORD=
NOTSIP_OAUTH_AUTHORIZE_URL=
NOTSIP_OAUTH_TOKEN_URL=
NOTSIP_OAUTH_CLIENT_ID=
NOTSIP_OAUTH_CLIENT_SECRET=
NOTSIP_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/api/oauth/callback
NOTSIP_OAUTH_SCOPES=
NOTSIP_ANDROID_POLL_SECONDS=3
NOTSIP_NODE_LEASE_SECONDS=90
NOTSIP_NODE_SHARED_SECRET=
NOTSIP_GITHUB_UPDATE_ENABLED=true
NOTSIP_GITHUB_REPOSITORY=Notsip-995/NOTSIP-Platform
# Windows Authenticode signer thumbprint required before frozen EXE replacement.
NOTSIP_WINDOWS_PUBLISHER_THUMBPRINT=
NOTSIP_LOG_LEVEL=INFO
NOTSIP_OPEN_BROWSER=true
